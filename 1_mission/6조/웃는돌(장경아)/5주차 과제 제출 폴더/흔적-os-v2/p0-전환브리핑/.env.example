# 흔적 OS v2 · P0 — 환경변수 예시
# 진짜 값은 이 파일이 아니라 Vercel 프로젝트 → Settings → Environments 에 넣는다.
# (2주차 교훈: 값을 바꾸면 반드시 Redeploy 해야 반영된다)

# ── 필수 ──────────────────────────────────────────────
# BotFather 봇 토큰
TELEGRAM_TOKEN=123456:ABC-DEF...

# 브리핑을 받을 내 텔레그램 chat id
#   확인법: 봇에게 아무 말이나 보낸 뒤
#   https://api.telegram.org/bot<토큰>/getUpdates  →  "chat":{"id":숫자}
ALLOWED_CHAT_ID=12345678

# v1 앱이 쓰는 Supabase 프로젝트
SUPABASE_URL=https://xxxxxxxx.supabase.co
# ⚠️ service_role 키. 서버에서만 쓴다. 절대 클라이언트·공개 저장소에 올리지 말 것
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# cron 엔드포인트 보호용. 아무 긴 문자열이나.
#   설정하면 Vercel Cron 이 자동으로 Authorization 헤더에 실어 보낸다.
#   비워두면 주소만 알면 누구나 브리핑을 강제 발송할 수 있다 → 반드시 설정
CRON_SECRET=아무거나-길고-랜덤한-문자열

# ── 선택 ──────────────────────────────────────────────
# 🎯 대상 역할 — '가장 비싼 전환' 하나. 착수 전에 본인이 확정할 것
FOCUS_ROLE=본업

# 저녁에 보여줄 후보 개수 (기본 3). 늘리지 말 것 — 선택 비용이 곧 재부팅이다
CANDIDATE_COUNT=3

# v1 흔적 테이블 이름 / '할일'을 뜻하는 값 (v1 스키마와 다르면)
TRACES_TABLE=traces
TRACES_KIND_TODO=할일

# 자유 문장을 담을 기본 역할 (P1에서 분류기 연결하면 안 쓰임)
UNSORTED_ROLE=미분류

# 텔레그램 webhook secret_token 과 대조할 값 (위조 요청 차단)
WEBHOOK_SECRET=
