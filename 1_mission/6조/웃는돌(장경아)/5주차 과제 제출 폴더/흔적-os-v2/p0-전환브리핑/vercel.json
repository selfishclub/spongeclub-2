{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "//": "🌙 저녁 승인 요청 — 21:30 KST = 12:30 UTC",
      "path": "/api/cron-evening",
      "schedule": "30 12 * * *"
    },
    {
      "//": "🟢 아침 전환 브리핑 — 09:00 KST = 00:00 UTC",
      "path": "/api/cron-morning",
      "schedule": "0 0 * * *"
    }
  ]
}
